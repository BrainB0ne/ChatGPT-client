{
  "name": "chatgpt",
  "version": "1.1.0",
  "description": "Linux-friendly Electron wrapper for ChatGPT",
  "homepage": "https://chatgpt.com",
  "main": "main.js",
  "author": {
    "name": "Stephan Coertzen",
    "email": "coertzen.jfs@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "releaseNotes": {
    "fromHash": "28cf9a9"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "release:linux": "npm run build:linux",
    "release:win": "npm run build:win"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.chatgpt",
    "productName": "ChatGPT",
    "npmRebuild": false,
    "publish": null,
    "afterPack": "scripts/after-pack-win.js",
    "files": [
      "build/icons/**",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "executableName": "chatgpt",
      "maintainer": "Stephan Coertzen <coertzen.jfs@gmail.com>",
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
