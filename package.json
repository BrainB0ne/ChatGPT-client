{
  "name": "chatgpt-ex",
  "version": "1.3.0",
  "description": "Extended desktop wrapper for ChatGPT with Markdown and PDF export",
  "homepage": "https://chatgpt.com",
  "main": "main.js",
  "author": {
    "name": "BrainByteZ"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "release:linux": "npm run build:linux",
    "release:win": "npm run build:win"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "eu.brainbytez.chatgpt-ex",
    "productName": "ChatGPT-EX",
    "npmRebuild": false,
    "publish": null,
    "afterPack": "scripts/after-pack-win.js",
    "files": [
      "build/icons/**",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "executableName": "chatgpt-ex",
      "maintainer": "BrainByteZ",
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
